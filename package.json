{
	"name": "symplex",
	"displayName": "Symplex",
	"description": "A Computer Algebra System for your code",
	"publisher": "zalo",
	"version": "0.1.0",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zalo/Symplex.git"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"algebra",
		"calculus",
		"symbolic",
		"integrate",
		"latex",
		"sympy",
		"symplex",
		"cas",
		"computer algebra system"
	],
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#ffffff",
		"theme": "light"
	},
	"activationEvents": [
		"onLanguage:javascript",
		"onLanguage:typescript",
		"onLanguage:python"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "symplex.Evaluate",
				"title": "Symplex: Symbolic Evaluate"
			},
			{
				"command": "symplex.GetExpression",
				"title": "Symplex: Get Expression"
			}
		],
		"menus": {
			"editor/context": [
				{
					"when": "editorHasSelection && resourceLangId =~ /^(javascript|typescript|python)$/",
					"command": "symplex.Evaluate",
					"group": "navigation@0"
				},
				{
					"when": "editorHasSelection && resourceLangId =~ /^(javascript|typescript|python)$/",
					"command": "symplex.GetExpression",
					"group": "navigation@1"
				}
			]
		},
		"configuration": {
			"title": "Symplex",
			"properties": {
				"symplex.engine": {
					"type": "string",
					"enum": [
						"embedded",
						"system"
					],
					"default": "embedded",
					"enumDescriptions": [
						"Run SymPy inside the extension via Pyodide (WebAssembly). No Python installation required.",
						"Run SymPy with a locally installed Python interpreter (requires `pip install sympy`)."
					],
					"description": "Which SymPy engine to use for symbolic evaluation."
				},
				"symplex.pythonPath": {
					"type": "string",
					"default": "",
					"description": "Path to the Python interpreter used by the 'system' engine. Leave empty to use 'python3' (or 'python' on Windows) from PATH."
				},
				"symplex.timeoutSeconds": {
					"type": "number",
					"default": 15,
					"description": "Maximum time in seconds a symbolic evaluation may run before it is cancelled."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run fetch-wheels",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src",
		"fetch-wheels": "node ./scripts/fetchWheels.js",
		"pretest": "npm run compile",
		"test": "node --test \"out/test/*.test.js\""
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"@types/vscode": "^1.90.0",
		"eslint": "^9.9.0",
		"typescript-eslint": "^8.0.0"
	},
	"dependencies": {
		"pyodide": "^314.0.3",
		"typescript": "^5.9.0"
	}
}
